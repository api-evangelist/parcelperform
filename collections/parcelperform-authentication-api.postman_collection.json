                    "oauth",
                    "token",
                    ""
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) Basic base64(client_id:client_secret).",
                    "key": "Authorization",
                    "value": "Basic base64Y2xpZW50X2lkOmNsaWVudF9zZWNyZXQ="
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
